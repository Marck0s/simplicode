        <condition/>
        <description/>
        <field>training_date</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>TrainingValidator</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
    // Não faz nada se o formulário estiver carregando ou o novo valor estiver vazio
    if (isLoading || newValue === '') {
        return;
    }

    // Obtém a data escolhida
    var pickUpDate = new Date(newValue);

    // Formata a data escolhida para o formato 'yyyy-mm-dd'
    var selectedDateOnly = pickUpDate.toISOString().split('T')[0];

    // Verifica se o campo de nome do treinamento (matéria) está preenchido
    var trainingName = g_form.getValue('training');  // 'training' deve ser o nome correto do campo de treinamento

    // Se não houver nome do treinamento ou data, retorna sem fazer nada
    if (!trainingName || !selectedDateOnly) {
        return;
    }

    // Chama o Script Include usando GlideAjax
    var ga = new GlideAjax('TrainingUtils');  // Chama o Script Include

    // Passa parâmetros para o Script Include
    ga.addParam('trainingName', trainingName);  // Passa o nome do treinamento (matéria)
    ga.addParam('trainingDate', selectedDateOnly); // Passa a data do treinamento

    // Faz a requisição e trata a resposta
    ga.getXMLAnswer(function(response) {
        var answer = response.responseXML.documentElement.getAttribute("answer");

        // Se a resposta for 'true', significa que já existe o treinamento para essa data e matéria
        if (answer === 'true') {
            g_form.addErrorMessage("A training session for this subject already exists on the selected date.");
            g_form.setValue('training_date', '');  // Limpa o campo de data
        } else {
            g_form.clearMessages();  // Limpa as mensagens de erro, se a data for válida
        }
    });
}
]]></script>
