        <description/>
        <mobile_callable>false</mobile_callable>
        <name>Validate Duplicate Agendas</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var TrainingValidator = Class.create();
TrainingValidator.prototype = {
    initialize: function() {},

    validateScheduleConflict: function() {
        var grade = this.getParameter('training'); // Obtemos o parâmetro "grade"
        var trainingDate = this.getParameter('training_date'); // Obtemos o parâmetro "training_date"

        // Consultamos a tabela de agendas de treinamento
        var gr = new GlideRecord('x_training_schedule'); // Substitua pelo nome da sua tabela de agendas
        gr.addQuery('grade', grade);
        gr.addQuery('training_date', trainingDate);
        gr.query();

        // Retorna "conflict" se já existir um registro
        if (gr.hasNext()) {
            return 'conflict';
        }

        return 'no_conflict'; // Sem conflitos
    },

    isPublic: function() {
        return true; // Permite o acesso via GlideAjax
    },

    type: 'TrainingValidator'
};
]]></script>
