        <messages/>
        <name>Validate Duplicate Agendas</name>
        <order/>
        <script><![CDATA[function onSubmit(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }

   // Obtém a data selecionada pelo usuário
   var selectedDate = new Date(newValue).toISOString().split('T')[0];

   // Executa consulta na tabela diretamente usando GlideRecord AJAX
   var duplicateFound = false;
   var gr = new GlideRecord('x_873666_simplic_0_training_agenda'); // Substitua pelo nome da sua tabela de agendas
   gr.addQuery('training_date', selectedDate); // Filtra pela data selecionada
   gr.addQuery('training', g_form.getValue('training')); // Filtra pelo treinamento atual
   gr.query();

   while (gr.next()) {
      duplicateFound = true; // Se encontrar um registro, marca como duplicado
      break;
   }

   // Exibe mensagem de erro se a data for duplicada
   if (duplicateFound) {
      g_form.addErrorMessage('This training already has a schedule on the selected date. Please choose another date.');
      g_form.setValue('training_date', ''); // Limpa o campo de data
      return;
   }

   // Limpa mensagens de erro caso não haja duplicatas
   g_form.clearMessages();
}
]]></script>
