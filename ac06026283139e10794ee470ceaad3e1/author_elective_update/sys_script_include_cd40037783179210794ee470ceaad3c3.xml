        <api_name>x_873666_simplic_0.PortalViewTreatmentsUtils</api_name>
        <caller_access/>
        <client_callable>false</client_callable>
        <description/>
        <mobile_callable>false</mobile_callable>
        <name>PortalViewTreatmentsUtils</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var PortalViewTreatmentsUtils = Class.create();
PortalViewTreatmentsUtils.prototype = {
	initialize: function () { },
	refQualAgenda: function () {

		//Hide if user Already Applied the Training once
		var notTobeShown = [];

		var grRegistration = new GlideRecord('x_873666_simplic_0_training_registration');
		grRegistration.addEncodedQuery("opened_byDYNAMIC90d1921e5f510100a9ad2572f2b477fe");
		grRegistration.query();
		while (grRegistration.next()) {
			notTobeShown.push(grRegistration.agenda.sys_id.toString());
		}

		//Limit Registration to 3 Times per Training
		var coursesLimitReached = [];

		var grCourseCount = new GlideAggregate('x_873666_simplic_0_training_registration');
		grCourseCount.addQuery("opened_byDYNAMIC90d1921e5f510100a9ad2572f2b477fe");
		grCourseCount.groupBy('agenda.training');
		grCourseCount.addAggregate('COUNT');
		grCourseCount.query();
		while (grCourseCount.next()) {
			if (grCourseCount.getAggregate('COUNT') >= 3) {
				coursesLimitReached.push(grCourseCount.getValue('agenda.training'));
			}
		}

		//Limit of Available Slots in a Training
		var fullyBookedTrainings = [];

		var grAgendaCheck = new GlideRecord('x_873666_simplic_0_training_agenda');
		grAgendaCheck.query();
		while (grAgendaCheck.next()) {
			var availableSlots = parseInt(grAgendaCheck.available_slots, 10) || 0;
			if (availableSlots <= 0) {
				fullyBookedTrainings.push(grAgendaCheck.getUniqueValue());
			}
		}

		//Prevent Instructors from Registrating in their own Trainings
		var instructorOwnedTrainings = [];
		var userId = gs.getUserID();

		var grInstructorCheck = new GlideRecord('x_873666_simplic_0_training_agenda');
		grInstructorCheck.addQuery("instructor_training", userId);
		grInstructorCheck.query();
		while (grInstructorCheck.next()) {
			instructorOwnedTrainings.push(grInstructorCheck.getUniqueValue());
		}

		//Validate Dup Trainings | More than 3 applications | Expired Trainings | Instructors to Own Trainings
		var toBeShown = [];

		var grAgenda = new GlideRecord('x_873666_simplic_0_training_agenda');
		grAgenda.query();

		while (grAgenda.next()) {
			var trainingCourse = grAgenda.training.toString();

			var currentDate = new Date();
			var trainingDate = new Date(grAgenda.training_date);

			currentDate.setHours(0, 0, 0, 0);
			trainingDate.setHours(0, 0, 0, 0);

			//Prevent registration if data training already passed by
			if (currentDate > trainingDate) {
				continue;
			}

			//Prevent registration if reached the limit of 3 for the same training
			if (coursesLimitReached.indexOf(trainingCourse) !== -1) {
				continue;
			}

			//Prevent registration if the number max of slots is full
			if (fullyBookedTrainings.indexOf(grAgenda.getUniqueValue()) !== -1) {
				continue;
			}

			//Prevent instructor's registration on their own trainings
			if (instructorOwnedTrainings.indexOf(grAgenda.getUniqueValue()) !== -1) {
				continue;
			}

			//Check if user is already registrated
			if (notTobeShown.indexOf(grAgenda.getUniqueValue()) == -1) {
				toBeShown.push(grAgenda.getUniqueValue());
			}
		}
		return "sys_idIN" + toBeShown.join(",");

	},
	type: 'PortalViewTreatmentsUtils'
};]]></script>
