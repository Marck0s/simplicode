        <messages/>
        <name>Duplicate</name>
        <order/>
        <script><![CDATA[function onSubmit() {
    var trainingName = g_form.getValue('training'); // Nome do treinamento
    var trainingDate = g_form.getValue('training_date'); // Data do treinamento

    if (!trainingName || !trainingDate) {
        return true; // Permite o envio se os campos obrigatórios não forem preenchidos
    }

    // Usar GlideAjax para verificar duplicidade
    var ga = new GlideAjax('CheckTrainingDuplicate');
    ga.addParam('sysparm_name', 'checkDuplicate');
    ga.addParam('training', trainingName);
    ga.addParam('training_date', trainingDate);

    // Executa a chamada de forma assíncrona
    ga.getXMLAnswer(function(response) {
        if (response === 'duplicate') {
            g_form.addErrorMessage('A training for this subject is already scheduled on the selected date. Please choose another date.');
            g_form.setValue('training_date', ''); // Limpa a data para evitar envios
            return false; // Impede o envio
        }

        // Se não houver duplicata, permite o envio
        g_form.submit(); // Submete o formulário manualmente
    });

    // Impede o envio até que a resposta seja recebida
    return false;
}
]]></script>
