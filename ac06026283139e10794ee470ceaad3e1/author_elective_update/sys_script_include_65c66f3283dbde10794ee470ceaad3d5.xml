        <name>TrainingUtils</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var TrainingUtils = Class.create();
TrainingUtils.prototype = {
    initialize: function() {},

    // Função para validar se já existe um treinamento agendado para a mesma matéria e data
    validateTraining: function(trainingName, trainingDate) {
        var gr = new GlideRecord('x_873666_simplic_0_training_agenda');  // Substitua pela tabela correta
        gr.addQuery('training', trainingName);  // Filtro pelo nome da matéria (treinamento)
        gr.addQuery('training_date', trainingDate);  // Filtro pela data do treinamento
        gr.query();

        return gr.hasNext() ? 'true' : 'false'; // Retorna 'true' se existe, 'false' caso contrário
    },

    // Método chamado pelo GlideAjax para validar a duplicidade
    validateTrainingAjax: function() {
        var trainingName = this.getParameter('trainingName');  // Obtém o nome da matéria
        var trainingDate = this.getParameter('trainingDate');  // Obtém a data do treinamento
        var result = this.validateTraining(trainingName, trainingDate);  // Chama a função de validação

        // Retorna a resposta para o Client Script
        return result;
    },

    type: 'TrainingUtils'  // Define o nome do tipo
};
]]></script>
