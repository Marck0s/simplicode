        <name>Validate Duplicate Dates</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[    (function executeAction(current, actionParams) {

        var gr = new GlideRecord('x_873666_simplic_0_training_agenda'); // Tabela onde estão os agendamentos
        gr.addQuery('training_date', current.training_date); // Verifica a data do agendamento
		gr.addQuery('trainingName', current.trainingName);
        gr.query();

        // Se encontrar um registro, significa que a data já está ocupada
        if (gr.next()) {
            gs.addErrorMessage('This training already has a schedule on the selected date. Please choose another date.');
            current.setValue('training_date', ''); // Limpa o campo de data
            return false;
        }

        // Se não encontrar duplicata, permite a continuidade do processo

        return true;
    })(current, actionParams);]]></script>
