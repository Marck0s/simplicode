        <description/>
        <mobile_callable>false</mobile_callable>
        <name>Training Validator </name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var TrainingValidator = Class.create();
TrainingValidator.prototype = {
    initialize: function() {},

    validateTraining: function(trainingName, trainingDate) {
        var gr = new GlideRecord('x_873666_simplic_0_training_agenda');  // Substitua com o nome correto da sua tabela de treinamento
        gr.addQuery('training', trainingName);  // Filtro pelo nome do treinamento
        gr.addQuery('training_date', trainingDate);  // Filtro pela data selecionada
        gr.query();

        // Retorna 'true' se encontrar um treinamento duplicado, senão retorna 'false'
        return gr.hasNext() ? 'true' : 'false';
    },

    // Método chamado pelo GlideAjax
    type: 'TrainingValidator',

    // Esta função é chamada pelo GlideAjax e retorna a resposta
    validateTrainingAjax: function() {
        var trainingName = this.getParameter('trainingName');  // Obtém o nome do treinamento
        var trainingDate = this.getParameter('trainingDate');  // Obtém a data do treinamento
        var result = this.validateTraining(trainingName, trainingDate);  // Chama o método de validação

        // Retorna a resposta para o Client Script
        return result;
    }
};
]]></script>
