        <messages/>
        <name>CheckTrainingDuplicate </name>
        <order/>
        <script><![CDATA[function onSubmit() {
    var trainingDate = g_form.getValue('training_date');
    var trainingName = g_form.getValue('training');

    // Cria um objeto GlideAjax para chamar o Script Include
    var ga = new GlideAjax('CheckTrainingDuplicate');
    ga.addParam('sys_id', 'checkDuplicate');
    ga.addParam('training_date', trainingDate);  // Passa a data do treinamento
    ga.addParam('training', trainingName);  // Passa o nome do treinamento

    // Chama o Script Include de forma assíncrona
    ga.getXMLAnswer(function(response) {
        var answer = response.responseXML.documentElement.getAttribute('answer');

        if (answer == 'duplicate') {
            g_form.addErrorMessage('A training for this subject is already scheduled on the selected date. Please choose another date.');
            g_form.setValue('training_date', '');  // Limpa o campo de data
            return false;  // Impede o submit
        } else {
            g_form.clearMessages();  // Limpa as mensagens de erro se não houver duplicidade
            // Não precisa retornar nada aqui, o form será enviado normalmente
        }
    });

    // Retorna false para impedir o submit até a validação assíncrona ser concluída
    return false;  // Impede o submit
}
]]></script>
