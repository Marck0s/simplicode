        <description/>
        <mobile_callable>false</mobile_callable>
        <name>CheckTrainingDuplicate </name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var CheckTrainingDuplicate = Class.create();
CheckTrainingDuplicate.prototype = Object.extendsObject(Global.AbstractAjaxProcessor, {

    checkDuplicate: function() {
        var trainingDate = this.getParameter('training_date'); // Data do treinamento
        var trainingName = this.getParameter('training_name'); // Nome do treinamento

        // Verifica se já existe um agendamento com a mesma data e o mesmo treinamento
        var gr = new GlideRecord('x_873666_simplic_0_training_agenda');
        gr.addQuery('training_date', trainingDate);  // Verifica a data
        gr.addQuery('training', trainingName);  // Verifica o nome do treinamento
        gr.query();

        // Se encontrar algum agendamento, retorna 'duplicate'
        if (gr.next()) {
            return 'duplicate';
        }
        
        // Se não encontrar, retorna 'available'
        return 'available';
    }
});
]]></script>
