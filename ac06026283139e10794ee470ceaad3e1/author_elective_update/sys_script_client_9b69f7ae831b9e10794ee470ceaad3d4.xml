    <sys_script_client action="DELETE">
        <active>true</active>
        <applies_extended>false</applies_extended>
        <condition/>
        <description/>
        <field>training_date</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Duplicate Dates</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
    if (isLoading || newValue === '') {
        return;
    }

    var selectedDateOnly = new Date(newValue).toISOString().split('T')[0]; // Data selecionada no formato 'yyyy-MM-dd'

    // Cria um objeto GlideAjax para chamar o Script Include
    var ga = new GlideAjax('CheckTrainingSchedule');
    ga.addParam('sys_id', 'checkSchedule');
    ga.addParam('training_date', selectedDateOnly);
    ga.addParam('training_name', g_form.getValue('trainingName'));

    // Faz a chamada assíncrona ao servidor
    ga.getXMLAnswer(function(response) {
        var answer = response.responseXML.documentElement.getAttribute('answer');

        // Verifica a resposta do Script Include
        if (answer === 'duplicate') {
            g_form.addErrorMessage('A training for this subject is already scheduled on the selected date. Please choose another date.');
            g_form.setValue('training_date', ''); // Limpa o campo de data
            return false; // Impede o agendamento
        }

        g_form.clearMessages(); // Limpa as mensagens de erro caso não haja duplicidade
    });
}
]]></script>
