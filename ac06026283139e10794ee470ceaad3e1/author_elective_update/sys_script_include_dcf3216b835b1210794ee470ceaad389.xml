        <script><![CDATA[var TrainingSchedulingValidation = Class.create();
TrainingSchedulingValidation.prototype = {
    initialize: function() {},

    // Função que verifica se existe outro treinamento para a mesma matéria na mesma data
    isTrainingScheduled: function(trainingSubject, trainingDate) {
        var grAgenda = new GlideRecord('x_873666_simplic_0_training_agenda');
        grAgenda.addQuery('training', training);
        grAgenda.query();
        
        // Obter data atual
        var currentDate = new Date();
        currentDate.setHours(0, 0, 0, 0); // Garantir que as horas sejam ignoradas

        while (grAgenda.next()) {
            var existingTrainingDate = new Date(grAgenda.training_date);
            existingTrainingDate.setHours(0, 0, 0, 0); // Garantir que as horas sejam ignoradas

            // Se a data do treinamento existente for igual à data fornecida, continua para o próximo registro
            if (existingTrainingDate.getTime() === trainingDate.getTime()) {
                return true;  // Já existe um treinamento na mesma data
            }

            // Caso contrário, continue verificando os outros registros
            continue;
        }

        // Caso contrário, retorna falso
        return false;
    },

    type: 'TrainingSchedulingValidation'
};
