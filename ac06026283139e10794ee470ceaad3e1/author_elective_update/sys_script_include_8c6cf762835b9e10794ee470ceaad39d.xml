        <script><![CDATA[var CheckTrainingSchedule = Class.create();
CheckTrainingSchedule.prototype = Object.extendsObject(AbstractAjaxProcessor, {
    
    checkSchedule: function() {
        var trainingDate = this.getParameter('training_date');
        var trainingName = this.getParameter('training_name');
        
        // Normaliza a data para evitar problemas de horário
        trainingDate = trainingDate.split('T')[0]; // Se for uma data com hora, pega apenas a parte da data

        var gr = new GlideRecord('x_873666_simplic_0_training_agenda');
        gr.addQuery('training_date', trainingDate); // Filtra pela data
        gr.addQuery('trainingName', trainingName); // Filtra pelo nome do treinamento
        gr.query();
        
        if (gr.next()) {
            return 'duplicate'; // Retorna 'duplicate' se encontrar um agendamento
        }
        
        return 'available'; // Retorna 'available' se não encontrar duplicata
    }
});

// Configuração para permitir a chamada via GlideAjax
CheckTrainingSchedule.prototype.isPublic = true;
]]></script>
