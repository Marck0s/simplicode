        <name>Delete User</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[var gr = new GlideRecord('x_873666_simplic_0_training_registration');  // Tabela de matrículas
gr.addQuery('training', g_form.getValue('training'));  // ID da agenda de treinamento
gr.addQuery('user', g_form.getValue('user'));  // ID do usuário
gr.query();

if (gr.next()) {
    var schedule = new GlideRecord('x_873666_simplic_0_training_agenda');  // Tabela de agendamentos
    if (schedule.get(gr.training)) {  // Usando o valor correto de 'training' no registro de matrícula
        schedule.available_slots++;  // Acrescenta 1 no número de slots
        schedule.update();
    }

    gr.deleteRecord();  // Remove o usuário da matrícula
    gs.addInfoMessage('Matrícula removida com sucesso e slot adicionado.');
} else {
    gs.addErrorMessage('Usuário não encontrado na matrícula.');
}

action.setRedirectURL(current);  // Redireciona para o registro atual]]></script>
