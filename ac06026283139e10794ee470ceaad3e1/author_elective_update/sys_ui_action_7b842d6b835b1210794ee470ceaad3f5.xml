        <name>PreventDupDatesUI</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[var trainingSubject = current.training;  
var trainingDate = new GlideDate(current.training_date).getDate();  

var validation = new PreventDupDatesUtil();  
var isScheduled = validation.isTrainingScheduled(trainingSubject, trainingDate);  

if (isScheduled) {

    gs.addErrorMessage('Já existe um treinamento agendado para essa matéria nesta data.');
    action.setAbortAction(true);
} else {

    gs.addInfoMessage('O agendamento foi validado com sucesso.');
}
]]></script>
